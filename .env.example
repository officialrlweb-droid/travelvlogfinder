# Optional: Auto-injected by Netlify Database when deployed on Netlify.
# NETLIFY_DB_URL=

# Optional: External PostgreSQL connection string (Neon, Supabase, RDS, local Postgres).
# When both NETLIFY_DB_URL and DATABASE_URL are omitted, TravelVlogFinder automatically runs
# embedded PostgreSQL (PGlite) persisted to ./.pgdata.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/travelvlogfinder

# Directory for embedded PGlite storage when DATABASE_URL is not set
PGLITE_DATA_DIR=.pgdata

# Optional: Auto-seed sample Kerala creators when the database is empty (default: true in development)
AUTO_SEED_DEMO=true

# Admin MVP password (used when admin panel is added)
ADMIN_PASSWORD=change-me-in-production

# Optional: Official Meta Graph oEmbed access token for Instagram oEmbed metadata
# META_OEMBED_TOKEN=
